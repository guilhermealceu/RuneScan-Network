# Porta onde o servidor Express ira rodar.
PORT=3005

# Por padrao, o RuneScan aceita conexoes somente deste computador.
# Para acessar de outras maquinas, use true e defina um token com 24+ caracteres.
ALLOW_LAN_ACCESS=false
API_TOKEN=""

# Servidor e modelo local usados pela analise de IA.
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:3b"
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_THREAD=4
# 0s descarrega o modelo da memoria assim que o parecer termina.
OLLAMA_KEEP_ALIVE="0s"

# URL publica opcional, caso a aplicacao seja hospedada.
APP_URL="MY_APP_URL"

# true bloqueia os endpoints de varredura real.
DISABLE_LIVE_SCAN=false

# Limites de seguranca da varredura e da captura passiva.
MAX_SCAN_ADDRESSES=4096
MAX_SCAN_TARGETS=16
MAX_CAPTURE_SECONDS=20

# Limites por endereco de origem. O botao Parar nao e bloqueado pelo limite geral.
API_RATE_LIMIT=180
AUTH_RATE_LIMIT=5
HEAVY_RATE_LIMIT=20

# Registro JSONL de inicio, conclusao, falha e cancelamento das varreduras.
AUDIT_LOG_PATH="logs/runescan-audit.jsonl"
